import (
  "libs/testing/testing.fal"
  "libs/collections/array/array.fal"
  "libs/collections/map/map.fal"
  "libs/falconCore/math/quantity/quantity.fal"
  "libs/falconCore/math/point/point.fal"
  "libs/falconCore/physics/deviceStructures/connection/connection.fal"
  "libs/falconCore/physics/units/symbolUnit/symbolUnit.fal"
  "libs/strings/strings.fal"
  "libs/log/log.fal"
  "../hub.fal"
  "../rayMeasurement.fal"
)

autotuner ScalableRayMeasurementTest -> (int passed, int failed) {
  passed = 0; failed = 0;
  start -> __init;

  // Test 1: Scalable 3-dot device with 1 sensor
  state test_3DotScalableRay (TestRunner runner, TestContext t) {
    hub::RestartDevice("3_dot_scalable.yml");

    connection::Connection p1 = connection::Connection.NewPlungerGate("P1");
    connection::Connection p2 = connection::Connection.NewPlungerGate("P2");
    connection::Connection p3 = connection::Connection.NewPlungerGate("P3");
    connection::Connection s1 = connection::Connection.NewPlungerGate("S1");
    symbolUnit::SymbolUnit volt = symbolUnit::SymbolUnit.Volt();

    // 1. Diagonal sweep across all 3 plungers
    map::Map<connection::Connection, quantity::Quantity> startMap = map::Map.New();
    startMap.Set(p1, quantity::Quantity.New(-0.5, volt));
    startMap.Set(p2, quantity::Quantity.New(-0.5, volt));
    startMap.Set(p3, quantity::Quantity.New(-0.5, volt));
    startMap.Set(s1, quantity::Quantity.New(0.0, volt));
    point::Point startPt = point::Point.NewFromQuantity(startMap);

    map::Map<connection::Connection, quantity::Quantity> endMap = map::Map.New();
    endMap.Set(p1, quantity::Quantity.New(0.5, volt));
    endMap.Set(p2, quantity::Quantity.New(0.5, volt));
    endMap.Set(p3, quantity::Quantity.New(0.5, volt));
    endMap.Set(s1, quantity::Quantity.New(0.0, volt));
    point::Point endPt = point::Point.NewFromQuantity(endMap);

    array::Array<point::Point> blips = rayMeasurement::MeasureRay(startPt, endPt, 200);
    int count = blips.Size();

    Array<string> logArgs = Array.New();
    logArgs.PushBack(strings::FromInt(count));
    log::Info(strings::Format("3-dot scalable diagonal detected {} blip(s)", logArgs));

    // Verify transitions detected across diagonal
    Error err1 = t.ExpectTrue(count >= 5, "Expected at least 5 charge transitions along 3-dot diagonal ray");

    // 2. Single gate sweep on P3 alone
    map::Map<connection::Connection, quantity::Quantity> startP3 = map::Map.New();
    startP3.Set(p1, quantity::Quantity.New(0.0, volt));
    startP3.Set(p2, quantity::Quantity.New(0.0, volt));
    startP3.Set(p3, quantity::Quantity.New(-0.5, volt));
    startP3.Set(s1, quantity::Quantity.New(0.0, volt));

    map::Map<connection::Connection, quantity::Quantity> endP3 = map::Map.New();
    endP3.Set(p1, quantity::Quantity.New(0.0, volt));
    endP3.Set(p2, quantity::Quantity.New(0.0, volt));
    endP3.Set(p3, quantity::Quantity.New(0.5, volt));
    endP3.Set(s1, quantity::Quantity.New(0.0, volt));

    array::Array<point::Point> blipsP3 = rayMeasurement::MeasureRay(point::Point.NewFromQuantity(startP3), point::Point.NewFromQuantity(endP3), 200);
    int countP3 = blipsP3.Size();

    Array<string> logArgsP3 = Array.New();
    logArgsP3.PushBack(strings::FromInt(countP3));
    log::Info(strings::Format("3-dot scalable P3 detected {} blip(s)", logArgsP3));

    Error err2 = t.ExpectTrue(countP3 >= 3, "Expected at least 3 blips along P3 sweep");

    -> __end(runner, t);
  }

  // Test 2: Scalable 6-dot device across multiple sensor groups (S1 and S2)
  state test_6DotScalableRay (TestRunner runner, TestContext t) {
    hub::RestartDevice("6_dot_scalable.yml");

    connection::Connection p1 = connection::Connection.NewPlungerGate("P1");
    connection::Connection p2 = connection::Connection.NewPlungerGate("P2");
    connection::Connection p3 = connection::Connection.NewPlungerGate("P3");
    connection::Connection p4 = connection::Connection.NewPlungerGate("P4");
    connection::Connection p5 = connection::Connection.NewPlungerGate("P5");
    connection::Connection p6 = connection::Connection.NewPlungerGate("P6");
    connection::Connection s1 = connection::Connection.NewPlungerGate("S1");
    connection::Connection s2 = connection::Connection.NewPlungerGate("S2");
    symbolUnit::SymbolUnit volt = symbolUnit::SymbolUnit.Volt();

    // 1. Ray sweep across dot group 1 (P1..P3, monitored by sensor S1)
    map::Map<connection::Connection, quantity::Quantity> startGroup1 = map::Map.New();
    startGroup1.Set(p1, quantity::Quantity.New(-0.5, volt));
    startGroup1.Set(p2, quantity::Quantity.New(-0.5, volt));
    startGroup1.Set(p3, quantity::Quantity.New(-0.5, volt));
    startGroup1.Set(p4, quantity::Quantity.New(0.0, volt));
    startGroup1.Set(p5, quantity::Quantity.New(0.0, volt));
    startGroup1.Set(p6, quantity::Quantity.New(0.0, volt));
    startGroup1.Set(s1, quantity::Quantity.New(0.0, volt));
    startGroup1.Set(s2, quantity::Quantity.New(0.0, volt));

    map::Map<connection::Connection, quantity::Quantity> endGroup1 = map::Map.New();
    endGroup1.Set(p1, quantity::Quantity.New(0.5, volt));
    endGroup1.Set(p2, quantity::Quantity.New(0.5, volt));
    endGroup1.Set(p3, quantity::Quantity.New(0.5, volt));
    endGroup1.Set(p4, quantity::Quantity.New(0.0, volt));
    endGroup1.Set(p5, quantity::Quantity.New(0.0, volt));
    endGroup1.Set(p6, quantity::Quantity.New(0.0, volt));
    endGroup1.Set(s1, quantity::Quantity.New(0.0, volt));
    endGroup1.Set(s2, quantity::Quantity.New(0.0, volt));

    array::Array<point::Point> blipsG1 = rayMeasurement::MeasureRay(
      point::Point.NewFromQuantity(startGroup1),
      point::Point.NewFromQuantity(endGroup1),
      200
    );
    int countG1 = blipsG1.Size();
    Array<string> logArgsG1 = Array.New();
    logArgsG1.PushBack(strings::FromInt(countG1));
    log::Info(strings::Format("6-dot group 1 ray detected {} blip(s)", logArgsG1));
    Error err1 = t.ExpectTrue(countG1 >= 5, "Expected at least 5 blips in group 1 ray");

    // 2. Ray sweep across dot group 2 (P4..P6, monitored by sensor S2)
    map::Map<connection::Connection, quantity::Quantity> startGroup2 = map::Map.New();
    startGroup2.Set(p1, quantity::Quantity.New(0.0, volt));
    startGroup2.Set(p2, quantity::Quantity.New(0.0, volt));
    startGroup2.Set(p3, quantity::Quantity.New(0.0, volt));
    startGroup2.Set(p4, quantity::Quantity.New(-0.5, volt));
    startGroup2.Set(p5, quantity::Quantity.New(-0.5, volt));
    startGroup2.Set(p6, quantity::Quantity.New(-0.5, volt));
    startGroup2.Set(s1, quantity::Quantity.New(0.0, volt));
    startGroup2.Set(s2, quantity::Quantity.New(0.0, volt));

    map::Map<connection::Connection, quantity::Quantity> endGroup2 = map::Map.New();
    endGroup2.Set(p1, quantity::Quantity.New(0.0, volt));
    endGroup2.Set(p2, quantity::Quantity.New(0.0, volt));
    endGroup2.Set(p3, quantity::Quantity.New(0.0, volt));
    endGroup2.Set(p4, quantity::Quantity.New(0.5, volt));
    endGroup2.Set(p5, quantity::Quantity.New(0.5, volt));
    endGroup2.Set(p6, quantity::Quantity.New(0.5, volt));
    endGroup2.Set(s1, quantity::Quantity.New(0.0, volt));
    endGroup2.Set(s2, quantity::Quantity.New(0.0, volt));

    array::Array<point::Point> blipsG2 = rayMeasurement::MeasureRay(
      point::Point.NewFromQuantity(startGroup2),
      point::Point.NewFromQuantity(endGroup2),
      200
    );
    int countG2 = blipsG2.Size();
    Array<string> logArgsG2 = Array.New();
    logArgsG2.PushBack(strings::FromInt(countG2));
    log::Info(strings::Format("6-dot group 2 ray detected {} blip(s)", logArgsG2));
    Error err2 = t.ExpectTrue(countG2 >= 5, "Expected at least 5 blips in group 2 ray");

    // 3. Full 6-dot diagonal ray across the entire device
    map::Map<connection::Connection, quantity::Quantity> startAll = map::Map.New();
    startAll.Set(p1, quantity::Quantity.New(-0.5, volt));
    startAll.Set(p2, quantity::Quantity.New(-0.5, volt));
    startAll.Set(p3, quantity::Quantity.New(-0.5, volt));
    startAll.Set(p4, quantity::Quantity.New(-0.5, volt));
    startAll.Set(p5, quantity::Quantity.New(-0.5, volt));
    startAll.Set(p6, quantity::Quantity.New(-0.5, volt));
    startAll.Set(s1, quantity::Quantity.New(0.0, volt));
    startAll.Set(s2, quantity::Quantity.New(0.0, volt));

    map::Map<connection::Connection, quantity::Quantity> endAll = map::Map.New();
    endAll.Set(p1, quantity::Quantity.New(0.5, volt));
    endAll.Set(p2, quantity::Quantity.New(0.5, volt));
    endAll.Set(p3, quantity::Quantity.New(0.5, volt));
    endAll.Set(p4, quantity::Quantity.New(0.5, volt));
    endAll.Set(p5, quantity::Quantity.New(0.5, volt));
    endAll.Set(p6, quantity::Quantity.New(0.5, volt));
    endAll.Set(s1, quantity::Quantity.New(0.0, volt));
    endAll.Set(s2, quantity::Quantity.New(0.0, volt));

    array::Array<point::Point> blipsAll = rayMeasurement::MeasureRay(
      point::Point.NewFromQuantity(startAll),
      point::Point.NewFromQuantity(endAll),
      200
    );
    int countAll = blipsAll.Size();
    Array<string> logArgsAll = Array.New();
    logArgsAll.PushBack(strings::FromInt(countAll));
    log::Info(strings::Format("6-dot full device ray detected {} blip(s)", logArgsAll));
    Error err3 = t.ExpectTrue(countAll >= 8, "Expected at least 8 blips across entire 6-dot device ray");

    -> __end(runner, t);
  }
}
