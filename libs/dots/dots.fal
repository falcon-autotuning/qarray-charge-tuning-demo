import (
)

struct Dot {
    Gate _gate;
    Voltage _energy;
    Direction _virtualizationAxis;
    routine New(Gate gate, Voltage energy, Direction dir) -> (Dot e){
        e._gate = gate;
        e._energy = energy;
        e._virtualizationAxis = dir;
    }
    routine UpdateEnergy(Voltage energy) -> () {
        e._energy = energy;
    }
    routine Gate() -> (Gate gate) {
        gate = this._gate;
    }
    routine Energy() -> (Voltage energy) {
        energy = this._energy;
    }
    routine Direction() -> (Direction dir) {
        dir = this._virtualizationAxis;
    }
    routine SetDirection(Direction dir) -> () {
        this._virtualizationAxis = dir;
    }
}

struct DotPair {
    int _first;
    int _second;

    routine New(int i, int j) -> (DotPair p) {
        if (i < j) {
            p._first = i;
            p._second = j;
        } else {
            p._first = j;
            p._second = i;
        }
    }

    routine First() -> (int first) {
        first = this._first;
    }

    routine Second() -> (int second) {
        second = this._second;
    }
}


struct DoubleDot {
    DotPair _pair;
    Voltage _interdotSpacingFirst;
    Voltage _interdotSpacingSecond;
    float _slopeFirstWithRespectToSecond; // dV_first / dV_second
    float _slopeSecondWithRespectToFirst; // dV_second / dV_first

    routine New(DotPair pair) -> (DoubleDot dd) {
        dd._pair = pair;
        dd._interdotSpacingFirst = 0.0;
        dd._interdotSpacingSecond = 0.0;
        dd._slopeFirstWithRespectToSecond = 0.0;
        dd._slopeSecondWithRespectToFirst = 0.0;
    }

    routine Pair() -> (DotPair pair) {
        pair = this._pair;
    }

    routine UpdateInterdotSpacing(Voltage spacingFirst, Voltage spacingSecond) -> () {
        this._interdotSpacingFirst = spacingFirst;
        this._interdotSpacingSecond = spacingSecond;
    }

    routine InterdotSpacing() -> (Voltage magnitude) {
        magnitude = Math::Sqrt(
            (this._interdotSpacingFirst * this._interdotSpacingFirst) +
            (this._interdotSpacingSecond * this._interdotSpacingSecond)
        );
    }

    routine InterdotSpacingFor(int dotIndex) -> (Voltage spacing) {
        if (dotIndex == _pair.First()) {
            spacing = this._interdotSpacingFirst;
        } else if (dotIndex == this._pair.Second()) {
            spacing = this._interdotSpacingSecond;
        } else {
            spacing = 0.0;
        }
    }

    routine SetSlopes(float slopeFirst_Second, float slopeSecond_First) -> () {
        this._slopeFirstWithRespectToSecond = slopeFirst_Second;
        this._slopeSecondWithRespectToFirst = slopeSecond_First;
    }

    routine Slope(int targetDot, int sweptDot) -> (float slope) {
        if (targetDot == _pair.First() && sweptDot == _pair.Second()) {
            slope = this._slopeFirstWithRespectToSecond;
        } else if (targetDot == _pair.Second() && sweptDot == _pair.First()) {
            slope = this._slopeSecondWithRespectToFirst;
        } else {
            slope = 0.0;
        }
    }
}

struct DotArray {
    Array<Dot> _dots;
    Map<DotPair, DoubleDot> _pairs;
    Map<Gate, int> _gateToIndex;

    routine New() -> (DotArray arr) {
        arr._dots = Array.New();
        arr._pairs = Map.New();
        arr._gateToIndex = Map.New();
    }

    routine AddDot(Dot d) -> (int index) {
        index = _dots.Size();
        _dots.Push(d);
        _gateToIndex.Set(d.Gate(), index);
    }

    routine GetDot(int index) -> (Dot d) {
        d = _dots.Get(index);
    }

    routine GetDotByGate(Gate gate) -> (Dot d) {
        int idx = _gateToIndex.Get(gate);
        d = _dots.Get(idx);
    }

    routine GetOrCreatePair(int i, int j) -> (DoubleDot dd) {
        DotPair key = DotPair.New(i, j);
        if (!_pairs.Contains(key)) {
            _pairs.Set(key, DoubleDot.New(key.First(), key.Second()));
        }
        dd = _pairs.Get(key);
    }

    routine UpdatePairSpacing(int i, int j, Voltage spacingI, Voltage spacingJ) -> () {
        DoubleDot dd = this.GetOrCreatePair(i, j);
        if (i < j) {
            dd.UpdateInterdotSpacing(spacingI, spacingJ);
        } else {
            dd.UpdateInterdotSpacing(spacingJ, spacingI);
        }
    }

    routine UpdatePairSlopes(int i, int j, float slopeI_J, float slopeJ_I) -> () {
        DoubleDot dd = this.GetOrCreatePair(i, j);
        if (i < j) {
            dd.SetSlopes(slopeI_J, slopeJ_I);
        } else {
            dd.SetSlopes(slopeJ_I, slopeI_J);
        }
    }

    routine GetSlope(int targetDot, int sweptDot) -> (float slope) {
        if (targetDot == sweptDot) {
            slope = 1.0;
        } else {
            DoubleDot dd = this.GetOrCreatePair(targetDot, sweptDot);
            slope = dd.Slope(targetDot, sweptDot);
        }
    }
}

