#!/bin/bash
# Auto-generated by CMake - do not edit manually
#
# Source this before running the demo:
#   . build/<preset>/env.sh && falcon-test ./tests/run_tests.fal --log-level info

export VCPKG_INSTALLED_DIR="@VCPKG_INSTALLED_DIR@"
export VCPKG_TRIPLET="@VCPKG_TARGET_TRIPLET@"
export CMAKE_BUILD_TYPE="@CMAKE_BUILD_TYPE@"
export CMAKE_BINARY_DIR="@CMAKE_BINARY_DIR@"
export CMAKE_SOURCE_DIR="@CMAKE_SOURCE_DIR@"

# The interpreter falcon-qarray-device and qarray-wrapper were built against.
export FALCON_QARRAY_PYTHON="@Python3_EXECUTABLE@"
# Where the falcon-qarray-device port installed device.py. Device.cpp bakes only
# a prefix-relative path, so hand it the absolute one.
export FALCON_QARRAY_PYTHON_PATH="@FALCON_QARRAY_PYTHON_PATH@"
# plplot finds its fonts and colour maps through this.
export PLPLOT_LIB="@PLPLOT_DATA_DIR@"
# Device config consumed by qarray-wrapper when QARRAY_CONFIG_PATH is unset.
export QARRAY_CONFIG_PATH="${QARRAY_CONFIG_PATH:-@CMAKE_SOURCE_DIR@/2_dot.yml}"
# PostgreSQL connection for the falcon-database stdlib package, which reads
# FALCON_DATABASE_URL and errors out if it is unset. Defaults to the
# credentials in docker-compose.test.yml (`make docker-up`); export your own
# value before sourcing this file to target a different server.
export FALCON_DATABASE_URL="${FALCON_DATABASE_URL:-postgresql://falcon_test:falcon_test_password@127.0.0.1:5432/falcon_test}"

export LD_LIBRARY_PATH="@VCPKG_TREE@/lib:@PYTHON_LIBRARY_DIR@:@CMAKE_BINARY_DIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# ── Falcon DSL toolchain, entirely inside vcpkg_installed (no /opt/falcon) ────
# falcon-run / falcon-test, relocated to tools/ by the falcon-dsl port.
export PATH="@VCPKG_TREE@/tools/falcon-dsl:$PATH"
# falcon-package-manager compiles each ffimport wrapper with $CXX, defaulting to
# g++. Point it at the same compiler this build used, so the DSL reproduces what
# the ffimport-flags test already validated. It matters concretely: falcon-core's
# Pair/Map/FArray headers declare constructors as `Pair<T1,T2>(const Pair&)`,
# which g++ rejects under -std=c++20 (hub.fal passes -std=c++20), and
# qarray-wrapper.cpp uses compound literals that g++ rejects in C++ but clang
# accepts. Both compile cleanly with clang-18.
export CXX="@CMAKE_CXX_COMPILER@"
# Where falcon-package-manager looks for pre-installed .fal standard-library
# packages. It scans each entry recursively for directories holding a falcon.yml.
# Only imports written WITHOUT a leading "./" or "../" consult this — a relative
# import is resolved against the importing file and never reaches the search path.
export FALCON_LIBRARY_PATH="@VCPKG_TREE@/share/falcon${FALCON_LIBRARY_PATH:+:$FALCON_LIBRARY_PATH}"
