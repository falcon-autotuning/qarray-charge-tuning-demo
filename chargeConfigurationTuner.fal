struct DotChargingEnergy {
    Connection _gate;
    Voltage _energy;
    routine New(Connection gate, Voltage energy) -> (DotChargingEnergy e){
        e._gate = gate;
        e._energy = energy;
    }
    routine UpdateEnergy(Voltage energy) -> () {
        e._energy = energy;
    }
    routine Gate() -> (Connection gate) {
        gate = this._gate;
    }
    routine Energy() -> (Voltage energy) {
        energy = this._energy;
    }
}

