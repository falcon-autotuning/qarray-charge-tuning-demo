struct BlipConePair {
    BlipConeRay _first;
    BlipConeRay _second;

    routine New(float theta, BlipConeRay principalAxis, Array<Gate> planeOfRotation) -> (BlipConePair cone) {
        ControlAxis rawRay = principalAxis.Ray();
        Direction rawDir = rawRay.Direction();
        Direction firstDirection = rawRay.Copy();
        firstDirection.Rotate(theta, planeOfRotation);
        this._first = BlipConeRay.New(ControlAxis.NewFromPointAndDirection(principalAxis.Offset(), firstDirection));
        Direction secondDirection = rawRay.Copy();
        secondDirection.Rotate(-1 * theta, planeOfRotation);
        this._second = BlipConeRay.New(ControlAxis.NewFromPointAndDirection(principalAxis.Offset(), secondDirection));
    }

    routine FirstRay () -> (BlipConeRay first) {
        first = this._first;
    }

    routine SecondRay () -> (BlipConeRay second) {
        second = this._second;
    }

    routine SetFirstBlips (Array<Point> blips) -> () {
        _first.SetBlips(blips);
    }

    routine SetSecondBlips (Array<Point> blips) -> () {
        _second.SetBlips(blips);
    }

    routine Characterize(
        Point tip,
        Voltage extent,
        int properBlipCount
    ) -> (bool valid) {
        valid = true;
        this.SetFirstBlips(
            CharacterizeRay(
                this.FirstRay(),
                tip,
                extent
            )
        );
        BlipConeRay first = this.FirstRay();
        if (first.CountBlips() == properBlipCount) {
            this.SetSecondBlips(
                CharacterizeRay(
                    this.SecondRay(),
                    tip,
                    extent
                )
            );
            BlipConeRay second= this.SecondRay();
            if (second.CountBlips() == properBlipCount) {
                valid = false;
            }
        } else {
            valid = false;
        }

    }
}

