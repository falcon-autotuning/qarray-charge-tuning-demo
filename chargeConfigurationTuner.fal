// The device has had some minor characterizations of TODO due to previous Coulomb blockade measurements
// The starting point is approximately 0.25 to 0.75 TODO in front of the first blip for all dots in the array
// The ending point is approximately 0.25 to 0.75 TODO after the TODO of the first blip for all dots in the array
// Assuming an SNR >= 4 for coulomb blockade from the environment
// We assume barriers are ignored and completely virtualized
// Assume only nearest neigboring plunger gate interactions
// Assume that virtual sweep axis are parallel enough to real sweep axes such that ... 
// Assume that the neigboring dots coupling is ... such that once placed in the center of a coulomb blockade window any coupling won't take it out
autotuner SingleElectronTuner() -> (Error err) {
    err = nil;
    int loadedDotSearchCount= 2;
    float theta = 3.14159/ 12;
    start -> bootstrap;
    state bootstrap {
        Iterator<Dot> dotIter = Iterator.New(QueryInitialVirtualization(GetPlungerGates()));
        -> characterizeEnergySpectra(dotIter);
    }
    state characterizeEnergySpectra (Iterator<Dot> iter) {
        Dot currentDot= iter.Evaluate();
        ControlAxis axis = NewFromPointAndDirection(CurrentVoltageState(), currentDot.Direction()); 
        BlipConeRay ray = BlipConeRay.New(axis);
        ray.SetBlips( 
            CharacterizeRay(
                ray,
                axis.Point(),
                loadedDotSearchCount * currentDot.Energy()
            )
        );
        // Assume initial guess is good enough in direction to get to 2 blips with enough magnitude
        if (ray.CountBlips() < loadedDotSearchCount) {
            currentDot.UpdateEnergy(1.5*distance);
            -> characterizeEnergySpectra(iter);
        } elif (blips.Size() > loadedDotSearchCount) {
            currentDot.UpdateEnergy(blips[1]- blips[0]);
            -> characterizeEnergySpectra(iter);
        } else { // Force seeing only loadedDotSearchCount blips
            currentDot.UpdateEnergy(blips[1]- blips[0]);
            -> estimateInterDot(iter, ray);
        }
    } 
    state estimateInterDot(Iterator<Dot> iter, BlipConeRay principleAxis) {
        // TODO: rays to search for interdot width
        -> estimateVirtualizationCoefficient(iter);
    }
    state estimateVirtualizationCoefficient (Iterator<Dot> iter, BlipConeRay principleAxis) {
        Dot currentDot= iter.Evaluate();
        BlipConePair first = BlipConePair.New(theta, principalAxis, BuildFirstRotationPlane(iter)); 
        bool firstIsValid = first.Characterize(
            principalAxis.Offset(),
            loadedDotSearchCount * currentDot.Energy(),
            loadedDotSearchCount 
        );
        if (!firstIsValid) {
            // Should fix by performing a rotation
            -> failBlips(iter, first);
        }
        // if your energy difference along the principalAxis is the shortest of the fan, then it is wrong
        //currentDot.UpdateEnergy(ComputCurrentEnergyDifference(principleAxis, first, loadedDotSearchCount));
        if (iter.HasNext()) {
            Dot nextDot= iter.Look(1);
            nextDot.SetDirection(ComputeUpdatedNextDirection(principleAxis, first, nextDot.Gate()));
        }
        if (iter.HasPrevious()) {
            BlipConePair first = BlipConePair.New(theta, principalAxis, BuildSecondRotationPlane(iter)); 
            bool secondIsValid = second.Characterize(
                principalAxis.Offset(),
                loadedDotSearchCount * currentDot.Energy(),
                loadedDotSearchCount
            );
            if (!secondIsValid) {
                // Should fix by performing a rotation
                -> failBlips(iter, second);
            }
            currentDot.UpdateEnergy(ComputeCurrentEnergyDifference(principleAxis, second, loadedDotSearchCount));
            Dot previousDot = iter.Look(-1);
            previousDot.SetDirection(ComputeUpdatedPreviousDirection(principleAxis, second, previousDot.Gate()));
        }
        -> loadElectron(iter);
    }
    state loadElectron (Iterator<Dot> iter) {
        DomainAxis domain = ComputeLocation(iter, CurrentVoltageState());
        Ramp(domain);
        if (iter.Increment()) {
            -> characterizeEnergySpectra(iter);
        }
        else {
            terminal;
        }
    }
    state failBlips (Iterator<Dot> iter, BlipConePair pair) {
        Dot energy = iter.Evaluate();
        Gate conn= energy.Gate();
        Array<string> args = Array.New();
        args.PushBack(conn.Name());
        BlipConeRay first = pair.FirstRay();
        args.PushBack(string::FromInt(first.CountBlips()));
        BlipConeRay second= pair.SecondRay();
        args.PushBack(string::FromInt(second.CountBlips()));
        err = Error.New(string::Format("failed to detect atleast two blips on gate {} and found number of blips on left ray: {} and found number of blips on right ray: {}", args));
    }
}

