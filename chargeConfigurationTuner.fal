struct BlipConeRay {
    ControlAxis _ray;
    Array<Point> _blips;

    routine New(ControlAxis ray) -> (BlipConeRay coneray) {
        coneray._ray = ray;
        coneray._blips = Array.New();
    }

    routine Ray() -> (ControlAxis ray) {
        ray = this._ray;
    }

    routine SetBlips(
        Array<Point> blips
    ) -> () {
        this._blips = blips;
    }

    routine Blips() -> (Array<Point> blips) {
        blips = this._blips;
    }

    routine CountBlips() -> (int count) {
        count = _blips.Size();
    }
}


