// TODO: read from spec the virtualized axis parameters for the gate 
routine GetVirtualizedAxis(deviceVoltageStates states, Gate gate) -> (ControlAxis axis)

struct Dot {
    Connection _gate;
    Voltage _energy;
    routine New(Connection gate, Voltage energy) -> (Dot e){
        e._gate = gate;
        e._energy = energy;
    }
    routine UpdateEnergy(Voltage energy) -> () {
        e._energy = energy;
    }
    routine Gate() -> (Connection gate) {
        gate = this._gate;
    }
    routine Energy() -> (Voltage energy) {
        energy = this._energy;
    }
}

routine ComputeRotationPlanes(
    Iterator<Dot> iter
) -> (
    Array<Gate> firstPlane,
    Array<Gate> secondPlane
) {
    firstPlane = Array.New();
    secondPlane = Array.New();

    Dot current = iter.Evaluate();

    if (iter.CanLook(1)) {
        Dot next = iter.Look(1);
        firstPlane.PushBack(
            current.Gate()
        );
        firstPlane.PushBack(
            next.Gate()
        );
    }

    if (iter.CanLook(-1)) {
        Dot previous = iter.Look(-1);
        secondPlane.PushBack(
            previous.Gate()
        );
        secondPlane.PushBack(
            current.Gate()
        );
    }
}

// TODO: build this from estimated charging energies from database
routine QueryChargingEnergies(Array<Gate> gates) -> (Array<Dot> dots)

struct BlipConeRay {
    ControlAxis _ray;
    Array<Point> _blips;

    routine New(ControlAxis ray) -> (BlipConeRay coneray) {
        coneray._ray = ray;
        coneray._blips = Array.New();
    }

    routine Ray() -> (ControlAxis ray) {
        ray = this._ray;
    }

    routine SetBlips(
        Array<Point> blips
    ) -> () {
        this._blips = blips;
    }

    routine Blips() -> (Array<Point> blips) {
        blips = this._blips;
    }
}


// TODO: implement waveform and analysis. Must ramp back to following inverse path after finding blips
routine BlipFinder (DomainAxis axis) -> (Array<Point> blips)

routine CharacterizeRay(
    BlipConeRay ray,
    Point tip,
    Voltage energy
) -> (Array<Point> blips) {
    Point end = ray.ToPoint(energy);

    DomainAxis domain =
        DomainAxis.New(
            tip,
            end
        );

    blips = BlipFinder(domain);
}

struct BlipConePair {
    BlipConeRay _first;
    BlipConeRay _second;

    // TODO: New creates proper controlAxis for each ray
    routine New(float theta, BlipConeRay principalAxis, Array<Gate> planeOfRotation) -> (BlipConePair cone)
    // Does rotation and extension to principalAxis surface

    routine FirstRay () -> (BlipConeRay first) {
        first = this._first;
    }

    routine SecondRay () -> (BlipConeRay second) {
        second = this._second;
    }

    routine SetFirstBlips (Array<Point> blips) -> () {
        _first.SetBlips(blips);
    }

    routine SetSecondBlips (Array<Point> blips) -> () {
        _second.SetBlips(blips);
    }

    routine Characterize(
        Point tip,
        Voltage extent
    ) -> () {
        this.SetFirstBlips(
            CharacterizeRay(
                this.FirstRay(),
                tip,
                extent
            )
        );

        this.SetSecondBlips(
            CharacterizeRay(
                this.SecondRay(),
                tip,
                extent
            )
        );
    }
}

// BlipCone contains all the blips measured in the cone geometry
struct BlipCone {
    BlipConeRay _principle;
    BlipConePair _first;
    BlipConePair _second;

    // New creates proper controlAxis for each ray
    routine New(float theta, BlipConeRay principalAxis, Array<Gate> firstPlaneOfRotation, Array<Gate> secondPlaneOfRotation) -> (BlipCone cone) {
        cone._principle = principalAxis;
        cone._first = BlipConePair.New(theta, principalAxis,firstPlaneOfRotation); 
        cone._second = BlipConePair.New(theta, principalAxis,secondPlaneOfRotation); 
    }

    routine PrincipalAxis() -> (Array<Point> axis) {
        axis = this._principalAxis;
    }

    routine Tip() -> (Point tip) {
        tip = _principle.Offset();
    }
    
    routine Axis() -> (Direction axis) {
        axis = _principle.Direction();
    }

    routine FirstPair () -> (BlipConePair first) {
        first = this._first;
    }

    routine SetFirstAxisOfFirstBlipConePair(Array<Point> blips) -> () {
        _first.SetFirstBlips(blips);
    }

    routine SetSecondAxisOfFirstBlipConePair(Array<Point> blips) -> () {
        _first.SetSecondBlips(blips);
    }

    routine SecondPair () -> (BlipConePair second) {
        second = this._second;
    }

    routine SetFirstAxisOfSecondBlipConePair(Array<Point> blips) -> () {
        _second.SetFirstBlips(blips);
    }

    routine SetSecondAxisOfSecondBlipConePair(Array<Point> blips) -> () {
        _second.SetSecondBlips(blips);
    }

}

// TODO: compute the location gate voltage location of <1,...,1,0,...,0>  state
// Need to floor the surfaceCount since it needs to be an int to make sense 
// The found location can improve previous electron positioning in the case of 3D cone
routine ComputeLocation(BlipCone cone, float surfaceCount) -> (Point location)


// TODO: ramp the device following the DomainAxis
routine Ramp (DomainAxis axis) -> ()

// The device has had some minor characterizations of charging energies due to previous Coulomb blockade measurements
// The starting point is approximately 0.25 to 0.75 charging energies in front of the first blip for all dots in the array
// The ending point is approximately 0.25 to 0.75 charging energies after the charging energy of the first blip for all dots in the array
// Assuming an SNR >= 4 for coulomb blockade from the environment
// We assume barriers are ignored and completely virtualized
// Assume only nearest neigboring plunger gate interactions
// Assume that virtual sweep axis are parallel enough to real sweep axes such that ... 
// Assume that the neigboring dots coupling is ... such that once placed in the center of a coulomb blockade window any coupling won't take it out
autotuner SingleElectronTuner() -> (Error err) {
    err = nil;
    float chargingEnergySearchCount = 2.0;

    start -> bootstrap;
    state bootstrap {
        Array<Dot> chargingEnergies = QueryChargingEnergies(GetPlungerGates());
        Iterator<Dot> chargingEnergyIter = Iterator.New(chargingEnergies);
        -> characterizeEnergySpectra(chargingEnergies);
    }
    state characterizeEnergySpectra (Iterator<Dot> iter) {
        Dot energy= iter.Evaluate();
        ControlAxis axis = GetVirtualizedAxis(CurrentVoltageState(), energy.Gate()); 
        BlipConeRay ray = BlipConeRay.New(axis);
        ray.SetBlips( 
            CharacterizeRay(
                ray,
                axis.Point(),
                chargingEnergySearchCount * energy.Energy()
            )
        );
        Array<Point> blips = ray.Blips();
        if (blips.Size()<= 1) {
            energy.UpdateEnergy(1.5*distance);
            -> characterizeEnergySpectra(iter);
        } else {
            energy.UpdateEnergy(blips[1]- blips[0]);
            Array<Gate> firstPlane;
            Array<Gate> secondPlane;
            firstPlane, secondPlane = ComputeRotationPlanes(iter);
            BlipCone cone = BlipCone.New(theta, ray, firstPlane, secondPlane);
            -> estimateVirtualizationCoefficient(iter, cone);
        }
    } 
    state estimateVirtualizationCoefficient (Iterator<Dot> iter, BlipCone cone) {
        Dot energy = iter.Evaluate();
        BlipConePair first = cone.FirstPair();
        first.Characterize(
            cone.Tip(),
            chargingEnergySearchCount * energy.Energy()
        );
        if (iter.HasPrevious()) {
            BlipConePair second = cone.SecondPair();
            second.Characterize(
                cone.Tip(),
                chargingEnergySearchCount * energy.Energy()
            )
        }
        Point location = ComputeLocation(cone, chargingEnergySearchCount);
        -> loadElectron(iter, location);
    }
    state loadElectron (Iterator<Dot> iter, Point location) {
        DomainAxis domain = DomainAxis.New(CurrentVoltageState(), location);
        Ramp(domain);
        if (iter.Increment()) {
            -> characterizeEnergySpectra(iter);
        }
        else {
            terminal;
        }
    }
    state crash (Iterator<Dot> iter) {
        Dot energy= iter.Evaluate();
        Connection conn = energy.Gate();
        err = Error.New(strings::Concat("Failed to load an electron for gate ",conn.Name());
        terminal;
    }
}

