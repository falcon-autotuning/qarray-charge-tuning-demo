struct Dot {
    Connection _gate;
    Voltage _energy;
    Direction _virtualizationAxis;
    routine New(Connection gate, Voltage energy, Direction dir) -> (Dot e){
        e._gate = gate;
        e._energy = energy;
        e._virtualizationAxis = dir;
    }
    routine UpdateEnergy(Voltage energy) -> () {
        e._energy = energy;
    }
    routine Gate() -> (Connection gate) {
        gate = this._gate;
    }
    routine Energy() -> (Voltage energy) {
        energy = this._energy;
    }
    routine Direction() -> (Direction dir) {
        dir = this._virtualizationAxis;
    }
    routine SetDirection(Direction dir) -> () {
        this._virtualizationAxis = dir;
    }
}

routine BuildFirstRotationPlane(
    Iterator<Dot> iter
) -> (
    Array<Gate> plane
) {
    plane = Array.New();
    Dot current = iter.Evaluate();
    if (iter.CanLook(1)) {
        Dot next = iter.Look(1);
        plane.PushBack(
            current.Gate()
        );
        plane.PushBack(
            next.Gate()
        );
    }
}

routine BuildSecondRotationPlane(
    Iterator<Dot> iter
) -> (
    Array<Gate> plane
) {
    plane = Array.New();
    Dot current = iter.Evaluate();
    if (iter.CanLook(-1)) {
        Dot previous = iter.Look(-1);
        plane.PushBack(
            previous.Gate()
        );
        plane.PushBack(
            current.Gate()
        );
    }
}

