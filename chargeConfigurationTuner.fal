/*
 Psuedo Algorithm code:

Step 1: Initialize
Assume initial starting point := (-(+)AV, ...) where AV is the average charging energy from the literature.
A good source would be Sam Neyen's Intel paper. electrons(holes)

Step 2: Calculate the charging energy
sweep starting point -> (+(-)2*AV,-(+)AV,...) and check for 2 transitions
if less than 2 blips sweep further by increasing by 1.5x until 2 transitions
(T1,-(+)AV, ...) := first transition point
(T2,-(+)AV, ...) := second transition point
CE = abs(T2-T1) := the charging energy

we can make an interpolated line at (T1 +(-)xCE, -(+)AV, ...) with x on [0,1]
x can be physically motivated, RN it is 0.5
C1ax(z) := T1 +(-)zCE 
C1 :=(C1ax(x), -(+)AV,...)

Step 3: Calculate slope
theta := tan-1(0.5AV/2CE)
sweep (T1 -(+)0.5CE, -(+)AV, ...) -> (T1 +(-)1.5CE,-(+)AV +(-)2CE*tan(theta),-(+)AV,...)
sweep (T1 -(+)0.5CE, -(+)AV, ...) -> (T1 +(-)1.5CE,-(+)AV -(+)2CE*tan(theta),-(+)AV,...)

reduced math:
sweep1 (T1 -(+)0.5CE, -(+)AV, ...) -> (T1 +(-)0.5CE,-(+)0.5AV,-(+)AV,...)
sweep2 (T1 -(+)0.5CE, -(+)AV, ...) -> (T1 +(-)0.5CE,-(+)1.5AV,-(+)AV,...)

for sweep 1:
(Tx1,Ty1,-(+)AV, ...) := transition point
for sweep 2:
(Tx2,Ty2,-(+)AV, ...) := transition point
slope1 := abs(Ty2-Ty1)/abs(Tx2-Tx1)

Step 4: Find interdot
y := AV
C1bx(z) := C1ax(z) -(+)(1/slope1)*z
C1by(z) := -(+)AV +(-)slope1*z
sweep C1 -> (C1bx(y), C1by(z), -(+)AV, ...)
if a transisition does not occur, increase y by 1.5* and try again
(Tx1b,Ty1b,-(+)AV, ...) := transition point
Backing up to a safe starting spot
C1b := (Tx1b +(-)0.5AV/slope1 , Ty1b -(+)0.5AVslope1, -(+)AV, ...)
Querying slope
phi can be physically motivated, RN it is pi/12
sweep C1b -> (C1bx(y) - sin(phi)*sqrt((C1bx(y) - Tx1b -(+)0.5AV/slope1)^2 + (C1by(y) - Ty1b +(-)0.5AVslope1)^2), C1by(y), -(+)AV, ...)
(Tx2b,Ty2b,-(+)AV, ...) := transition point
slope2 := abs(Ty2b-Ty1b)/abs(Tx2b-Tx1b)
We know that the smallest interdot would occur where the slopes intersect at 
(T1 -(+)(1/slope1)*w, C1by(w), -(+)AV, ...), float w
(Tx1b -(+)(1/slope2)*z, Ty1b +(-)slope2*z,-(+)AV, ...0, float z
Solving these two equations for z,w for simultaneous z', w' solutions
Ix1 := Tx1b -(+)(1/slope2)*z'
Iy1 := Ty1b +(-)slope2*z'
maxguess := (Ix1, Iy1, -(+)AV, ...)
now we want to query transitions searching at a slope of slope1
(T1 -(+)(1/slope1)*w, C1by(w), -(+)AV, ...), float w
(Tx1b +(-)0.5AV/slope1 -(+)(1/slope2)*z, Ty1b -(+)0.5AVslope1 +(-)slope2*z, -(+)AV, ...), float z
Solving these two equations for z,w for simultaneous z'', w'' solutions
start1 := (Tx1b +(-)0.5AV/slope1 -(+)(1/slope2)*z''(1-z), Ty1b -(+)0.5AVslope1 +(-)slope2*z''(1-z), -(+)AV, ...), z on [0,1]
stop1 TODO: Needs to be a function of same z 
run Newton's method on the start1 and stop1, with a tolerance 1uV
TODO: Begin optimization searchign for interdot, biforcating w to the left, Newton's method perhaps

We will know the point of the interdot, and both slopes connecting to it for the boundary of charge state (1,1,0,...)
We will know the point of upper right corner of the charge state (0, 1, 0, ...)

We know orthogonal directions for both slopes 
Split the distance between the two points, and take average direction between those two slopes

 TODO: choose a starting point in along the orthogonal direction on the point halving the distance.
Sweep 2AV until 2 transisitons occur (we already know the slope)
Compute dot product onto real gate axis to get CE between transistions

 TODO: navigate to the center of the charge state (1,1,0...)
Sweep in new axis orthogonal direction by some theta. gets us a slope for P2 P3
TODO find interdot, we need to choose an x such that we stay in the previous charge cell

TODO: iterate

*/

// The device has had some minor characterizations of TODO due to previous Coulomb blockade measurements
// The starting point is approximately 0.25 to 0.75 TODO in front of the first blip for all dots in the array
// The ending point is approximately 0.25 to 0.75 TODO after the TODO of the first blip for all dots in the array
// Assuming an SNR >= 4 for coulomb blockade from the environment
// We assume barriers are ignored and completely virtualized
// Assume only nearest neigboring plunger gate interactions
// Assume that virtual sweep axis are parallel enough to real sweep axes such that ... 
// Assume that the neigboring dots coupling is ... such that once placed in the center of a coulomb blockade window any coupling won't take it out
autotuner SingleElectronTuner() -> (Error err) {
    err = nil;
    int loadedDotSearchCount= 2;
    float theta = 3.14159/ 12;
    start -> bootstrap;
    state bootstrap {
        // TODO: Initialize initial position based on literature charging energies and charge sign 
        // If electron loading start below 1 typical charging energy below 0V on all plungers
        // If hole loading, consider inverting entire algorithm
        Iterator<Dot> dotIter = Iterator.New(QueryInitialVirtualization(GetPlungerGates()));
        -> characterizeEnergySpectra(dotIter);
    }
    state characterizeEnergySpectra (Iterator<Dot> iter) {
        Dot currentDot= iter.Evaluate();
        ControlAxis axis = NewFromPointAndDirection(CurrentVoltageState(), currentDot.Direction()); 
        BlipConeRay ray = BlipConeRay.New(axis);
        ray.SetBlips( 
            CharacterizeRay(
                ray,
                axis.Point(),
                loadedDotSearchCount * currentDot.Energy()
            )
        );
        // Assume initial guess is good enough in direction to get to 2 blips with enough magnitude
        if (ray.CountBlips() < loadedDotSearchCount) {
            currentDot.UpdateEnergy(1.5*distance);
            -> characterizeEnergySpectra(iter);
        } elif (blips.Size() > loadedDotSearchCount) {
            currentDot.UpdateEnergy(blips[1]- blips[0]);
            -> characterizeEnergySpectra(iter);
        } else { // Force seeing only loadedDotSearchCount blips
            currentDot.UpdateEnergy(blips[1]- blips[0]);
            -> estimateVirtualizationCoefficient(iter, ray);
        }
    } 
    state estimateVirtualizationCoefficient (Iterator<Dot> iter, BlipConeRay principleAxis) {
        Dot currentDot= iter.Evaluate();
        BlipConePair first = BlipConePair.New(theta, principalAxis, BuildFirstRotationPlane(iter)); 
        bool firstIsValid = first.Characterize(
            principalAxis.Offset(),
            loadedDotSearchCount * currentDot.Energy(),
            loadedDotSearchCount 
        );
        if (!firstIsValid) {
            // Should fix by performing a rotation
            -> failBlips(iter, first);
        }
        // if your energy difference along the principalAxis is the shortest of the fan, then it is wrong
        //currentDot.UpdateEnergy(ComputCurrentEnergyDifference(principleAxis, first, loadedDotSearchCount));
        if (iter.HasNext()) {
            Dot nextDot= iter.Look(1);
            nextDot.SetDirection(ComputeUpdatedNextDirection(principleAxis, first, nextDot.Gate()));
        }
        if (iter.HasPrevious()) {
            BlipConePair first = BlipConePair.New(theta, principalAxis, BuildSecondRotationPlane(iter)); 
            bool secondIsValid = second.Characterize(
                principalAxis.Offset(),
                loadedDotSearchCount * currentDot.Energy(),
                loadedDotSearchCount
            );
            if (!secondIsValid) {
                // Should fix by performing a rotation
                -> failBlips(iter, second);
            }
            currentDot.UpdateEnergy(ComputeCurrentEnergyDifference(principleAxis, second, loadedDotSearchCount));
            Dot previousDot = iter.Look(-1);
            previousDot.SetDirection(ComputeUpdatedPreviousDirection(principleAxis, second, previousDot.Gate()));
        }
        -> loadElectron(iter);
    }
    state estimateInterDot(Iterator<Dot> iter, BlipConeRay principleAxis) {
        // TODO: rays to search for interdot width
        // Specifically, can navigate along the next-dimension virtual axis until observing a blip
        // with same slope, can step back current dot (plunger) voltage until observing no blip
        // should do this with search/refinement instead of fixed sized steps
        -> estimateVirtualizationCoefficient(iter);
    }
    state loadElectron (Iterator<Dot> iter) {
        DomainAxis domain = ComputeLocation(iter, CurrentVoltageState());
        Ramp(domain);
        if (iter.Increment()) {
            -> characterizeEnergySpectra(iter);
        }
        else {
            terminal;
        }
    }
    state failBlips (Iterator<Dot> iter, BlipConePair pair) {
        Dot energy = iter.Evaluate();
        Gate conn= energy.Gate();
        Array<string> args = Array.New();
        args.PushBack(conn.Name());
        BlipConeRay first = pair.FirstRay();
        args.PushBack(string::FromInt(first.CountBlips()));
        BlipConeRay second= pair.SecondRay();
        args.PushBack(string::FromInt(second.CountBlips()));
        err = Error.New(string::Format("failed to detect atleast two blips on gate {} and found number of blips on left ray: {} and found number of blips on right ray: {}", args));
    }
}

