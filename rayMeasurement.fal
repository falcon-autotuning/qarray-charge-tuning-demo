import (
  "libs/collections/array/array.fal"
  "libs/collections/map/map.fal"
  "libs/falconCore/math/quantity/quantity.fal"
  "libs/falconCore/math/point/point.fal"
  "libs/falconCore/physics/deviceStructures/connection/connection.fal"
  "libs/falconCore/physics/units/symbolUnit/symbolUnit.fal"
  "libs/falconCore/communications/voltageStates/deviceVoltageStates/deviceVoltageStates.fal"
  "./hub.fal"
)

// Autotuner to execute a ray measurement and return the blip points
autotuner MeasureRay (point::Point startPoint, point::Point endPoint, int resolution) -> (array::Array<point::Point> blipPoints) {
  start -> sweep;

  state sweep {
    int num_blips;
    array::Array<deviceVoltageStates::DeviceVoltageStates> locations;
    num_blips, locations = hub::AnalyzeBlips(startPoint.Coordinates(), endPoint.Coordinates(), resolution);

    // Ramp back to initial start point
    hub::Ramp(startPoint.Coordinates());

    blipPoints = array::Array.New();
    if (num_blips > 0) {
      -> collect(0, num_blips, locations, blipPoints);
    } else {
      terminal;
    }
  }

  state collect (int idx, int total, array::Array<deviceVoltageStates::DeviceVoltageStates> locs, array::Array<point::Point> pts) {
    deviceVoltageStates::DeviceVoltageStates dstate = locs.GetIndex(idx);
    pts.PushBack(dstate.ToPoint());
    int next_idx = idx + 1;
    if (next_idx < total) {
      -> collect(next_idx, total, locs, pts);
    } else {
      terminal;
    }
  }
}
